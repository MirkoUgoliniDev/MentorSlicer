# Included by CMakeLists, edited by the build script
# (the version numbers are generated by the build script from the git current label)

# F8: the fork is MentorSlicer (data folder %APPDATA%\MentorSlicer, MentorSlicer.exe/.conf).
set(SLIC3R_APP_NAME "MentorSlicer")
set(SLIC3R_APP_KEY "MentorSlicer")
set(SLIC3R_APP_USE_FORDER "MentorSlicer")
if(NOT DEFINED PROCESS_NAME)
set(PROCESS_NAME "MentorSlicer")
endif()
set(VENDOR_NAME "Creality")
set(STARTUP_PROJECT_NAME "${PROCESS_NAME}_app_gui")
set(SOLUTION_NAME "${PROCESS_NAME}")



if(NOT DEFINED CREALITYPRINT_VERSION)
set(CREALITYPRINT_VERSION "7.0.0.0")
endif()

string(REGEX MATCH "^[0-9]+\\.[0-9]+\\.[0-9]+\\.([0-9]+)" CREALITYPRINT_VERSION_WITH_BUILD "${CREALITYPRINT_VERSION}")
if(CMAKE_MATCH_1)
set(SLIC3R_BUILD_ID "${CMAKE_MATCH_1}")
elseif(NOT DEFINED SLIC3R_BUILD_ID OR "${SLIC3R_BUILD_ID}" STREQUAL "")
set(SLIC3R_BUILD_ID "$ENV{BUILD_ID}")
endif()

if(NOT DEFINED PROJECT_VERSION_EXTRA)
set(PROJECT_VERSION_EXTRA "Beta")
endif()

string(REGEX MATCH "^([0-9]+)\\.([0-9]+)\\.([0-9]+)" CXSW3D ${CREALITYPRINT_VERSION})
set(CREALITYPRINT_VERSION_MAJOR ${CMAKE_MATCH_1})
set(CREALITYPRINT_VERSION_MINOR ${CMAKE_MATCH_2})
set(CREALITYPRINT_VERSION_PATCH ${CMAKE_MATCH_3})
set(SLIC3R_VERSION "${CREALITYPRINT_VERSION}")
